---
import BallSling from "@/components/global/BallSling.astro";
import GoToTop from "@/components/global/GoToTop.astro";
import SmartLink from "@/components/global/SmartLink.astro";
import { buildContactMailtoHref } from "@/utils/contact";

interface Props {
  showBallSling?: boolean;
}

const { showBallSling = true } = Astro.props;
const contactHref = buildContactMailtoHref();
---

<footer>
  <div data-balls-gap class="pt-16 pb-16">
    <GoToTop />
    <div class="space-y-5">
      <p class="typo-nav text-balance text-center">
        © Joacim Eldre {new Date().getFullYear()}. All tights deserved. I promise that
        everything on this website is and will always be made by me, an ordinary
        human being made of <span class="inline-highlight px-1 bg-green-200 rounded" style="--selection-highlight: #bbf7d0;">jelly</span>.
      </p>
      <p class="typo-nav text-balance text-center">
        Say hi on <SmartLink
          href={contactHref}
          class="transition duration-200"
        >
          hei@joacimeldre.com</SmartLink
        >{" "}or{" "}
        <SmartLink
          href="https://bsky.app/profile/joacimeldre.com"
          class="transition duration-200"
        >
          Bluesky</SmartLink
        >.
      </p>
      <p class="typo-nav text-balance text-center">Oh and maybe visit my <SmartLink href="https://www.redbubble.com/people/ThingsWithFaces/shop" class="transition duration-200">print on demand shop</SmartLink> with clothes, stickers, and such.</p>
    </div>
  </div>
  {showBallSling && <BallSling />}
</footer>
