---
import SmartLink from "@/components/global/SmartLink.astro";

interface BlueskyImage {
  thumb: string;
  fullsize: string;
  alt: string;
}

interface BlueskyFeedItem {
  reason?: unknown;
  reply?: unknown;
  post: {
    uri: string;
    author: {
      handle: string;
    };
    record: {
      text?: string;
      createdAt?: string;
    };
    embed?: {
      $type?: string;
      images?: BlueskyImage[];
    };
  };
}

interface BlueskyFeedResponse {
  feed?: BlueskyFeedItem[];
}

interface LatestPost {
  text: string;
  publishedDate: string;
  publishedTime: string;
  dateTime: string;
  url: string;
  image?: BlueskyImage;
}

const actor = "joacimeldre.com";
let latestPost: LatestPost | undefined;

try {
  const response = await fetch(
    `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${actor}&limit=25&filter=posts_no_replies`,
    { signal: AbortSignal.timeout(3_000) },
  );

  if (response.ok) {
    const { feed = [] } = (await response.json()) as BlueskyFeedResponse;
    const item = feed.find(
      (candidate) =>
        !candidate.reason &&
        !candidate.reply &&
        candidate.post.author.handle === actor &&
        candidate.post.uri.startsWith("at://") &&
        candidate.post.record.createdAt,
    );
    const postId = item?.post.uri.split("/").at(-1);

    if (item && postId) {
      const embed = item.post.embed;
      latestPost = {
        text: item.post.record.text?.trim() || "View this post on Bluesky.",
        dateTime: item.post.record.createdAt!,
        publishedDate: new Intl.DateTimeFormat("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
          timeZone: "Europe/Oslo",
        }).format(new Date(item.post.record.createdAt!)),
        publishedTime: new Intl.DateTimeFormat("en-GB", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Europe/Oslo",
        }).format(new Date(item.post.record.createdAt!)),
        url: `https://bsky.app/profile/${actor}/post/${postId}`,
        image:
          embed?.$type === "app.bsky.embed.images#view"
            ? embed.images?.[0]
            : undefined,
      };
    }
  }
} catch {
}
---

{
  latestPost && (
    <section class="mt-8" aria-label="Latest post on Bluesky">
      <article class="bluesky-post">
        <p class="text-sm text-base-700">
          <SmartLink href={latestPost.url} class="bluesky-post__source-link" aria-label="Open on Bluesky"><span aria-hidden="true">εїз</span> <time datetime={latestPost.dateTime}>{latestPost.publishedDate}, {latestPost.publishedTime}</time></SmartLink>
        </p>
        <div class="bluesky-post__line">
          {
            latestPost.image && (
              <div class="bluesky-image">
                <button
                  type="button"
                  class="bluesky-image__trigger"
                  aria-label="Toggle larger image preview"
                  aria-expanded="false"
                >
                  <img
                    class="bluesky-image__thumb"
                    src={latestPost.image.thumb}
                    alt={latestPost.image.alt}
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                  <img
                    class="bluesky-image__large"
                    src={latestPost.image.fullsize}
                    alt=""
                    loading="lazy"
                  />
                </button>
              </div>
            )
          }
          <p>{latestPost.text}</p>
        </div>
      </article>
    </section>
  )
}

<style>
  .bluesky-post {
    margin-top: 0.75rem;
    container-type: inline-size;
  }

  .bluesky-post__line {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .bluesky-post__line > p {
    flex: 1 1 auto;
    min-width: 0;
  }

  .bluesky-post__source-link,
  .bluesky-post__source-link:hover,
  .bluesky-post__source-link:active,
  .bluesky-post__source-link:focus-visible {
    color: inherit !important;
    font-style: normal !important;
    text-decoration: none !important;
  }

  .bluesky-image {
    position: relative;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
  }

  .bluesky-image__trigger {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    padding: 0;
    cursor: zoom-in;
    background: none;
    border: 0;
    touch-action: manipulation;
    -webkit-touch-callout: none;
  }

  .bluesky-image.is-open .bluesky-image__trigger {
    cursor: zoom-out;
  }

  .bluesky-image__thumb {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0.25rem;
    object-fit: cover;
    box-shadow: 0 2px 5px 0 color-mix(in srgb, var(--color-base-950) 15%, transparent);
  }

  .bluesky-image__large {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    display: none;
    width: min(26.5rem, calc(100vw - 3rem));
    /* Overrides the global max-width that would clamp this to the 2.5rem thumbnail box. */
    max-width: none;
    height: auto;
    max-height: min(28rem, calc(100vh - 2rem));
    margin: 0;
    border-radius: 0.25rem;
    box-shadow: 0 2px 5px 0 color-mix(in srgb, var(--color-base-950) 15%, transparent);
  }

  .bluesky-image.is-open .bluesky-image__thumb {
    visibility: hidden;
  }

  .bluesky-image.is-open .bluesky-image__large {
    display: block;
  }
</style>

<script>
  const closeImage = (image: HTMLElement) => {
    image.classList.remove("is-open");
    image.querySelector(".bluesky-image__trigger")?.setAttribute("aria-expanded", "false");
  };

  document.querySelectorAll<HTMLElement>(".bluesky-image").forEach((image) => {
    const trigger = image.querySelector<HTMLElement>(".bluesky-image__trigger");

    trigger?.addEventListener("click", () => {
      const isOpen = image.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      document.querySelectorAll<HTMLElement>(".bluesky-image.is-open").forEach(closeImage);
    }
  });
</script>
