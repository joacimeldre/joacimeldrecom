---
import SmartLink from "@/components/global/SmartLink.astro";

interface BlueskyImage {
  thumb: string;
  fullsize: string;
  alt: string;
}

interface BlueskyAspectRatio {
  width: number;
  height: number;
}

interface BlueskyEmbed {
  $type?: string;
  images?: BlueskyImage[];
  playlist?: string;
  thumbnail?: string;
  alt?: string;
  aspectRatio?: BlueskyAspectRatio;
  external?: {
    uri?: string;
    title?: string;
    thumb?: string;
  };
}

interface BlueskyFeedItem {
  reason?: unknown;
  reply?: unknown;
  post: {
    uri: string;
    author: {
      handle: string;
    };
    record: {
      text?: string;
      createdAt?: string;
    };
    embed?: BlueskyEmbed;
  };
}

interface BlueskyFeedResponse {
  feed?: BlueskyFeedItem[];
}

interface Media {
  kind: "image" | "gif" | "video";
  thumb: string;
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface LatestPost {
  text: string;
  publishedDate: string;
  publishedTime: string;
  dateTime: string;
  url: string;
  media?: Media;
}

const isGifUrl = (uri: string) => {
  try {
    return new URL(uri).pathname.toLowerCase().endsWith(".gif");
  } catch {
    return false;
  }
};

const resolveMedia = (embed?: BlueskyEmbed): Media | undefined => {
  if (embed?.$type === "app.bsky.embed.images#view") {
    const image = embed.images?.[0];
    return image && { kind: "image", thumb: image.thumb, src: image.fullsize, alt: image.alt ?? "" };
  }

  if (embed?.$type === "app.bsky.embed.video#view" && embed.playlist && embed.thumbnail) {
    return {
      kind: "video",
      thumb: embed.thumbnail,
      src: embed.playlist,
      alt: embed.alt ?? "",
      width: embed.aspectRatio?.width,
      height: embed.aspectRatio?.height,
    };
  }

  const external = embed?.$type === "app.bsky.embed.external#view" ? embed.external : undefined;

  if (external?.uri && external.thumb && isGifUrl(external.uri)) {
    return {
      kind: "gif",
      thumb: external.thumb,
      src: external.uri,
      alt: external.title?.replace(/^ALT:\s*/i, "") ?? "",
    };
  }

  return undefined;
};

const actor = "joacimeldre.com";
const CACHE_TTL_MS = 15 * 60 * 1000;

// Survives per serverless instance, so warm invocations skip the Bluesky round-trip.
const cache = ((globalThis as Record<string, unknown>).__blueskyLatestPost ??= {
  expiresAt: 0,
}) as { expiresAt: number; post?: LatestPost };

let latestPost: LatestPost | undefined = cache.post;

if (Date.now() >= cache.expiresAt) {
  try {
    const response = await fetch(
      `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${actor}&limit=25&filter=posts_no_replies`,
      { signal: AbortSignal.timeout(3_000) },
    );

    if (response.ok) {
      const { feed = [] } = (await response.json()) as BlueskyFeedResponse;
      const item = feed.find(
        (candidate) =>
          !candidate.reason &&
          !candidate.reply &&
          candidate.post.author.handle === actor &&
          candidate.post.uri.startsWith("at://") &&
          candidate.post.record.createdAt,
      );
      const postId = item?.post.uri.split("/").at(-1);

      if (item && postId) {
        latestPost = {
          text: item.post.record.text?.trim() || "View this post on Bluesky.",
          dateTime: item.post.record.createdAt!,
          publishedDate: new Intl.DateTimeFormat("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
            timeZone: "Europe/Oslo",
          }).format(new Date(item.post.record.createdAt!)),
          publishedTime: new Intl.DateTimeFormat("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
            timeZone: "Europe/Oslo",
          }).format(new Date(item.post.record.createdAt!)),
          url: `https://bsky.app/profile/${actor}/post/${postId}`,
          media: resolveMedia(item.post.embed),
        };

        cache.post = latestPost;
        cache.expiresAt = Date.now() + CACHE_TTL_MS;
      }
    }
  } catch {
    // Keep serving the previously cached post, if any.
  }
}
---

{
  latestPost && (
    <section class="mt-8" aria-label="Latest post on Bluesky">
      <article class="bluesky-post">
        <p class="text-sm text-base-700">
          <SmartLink href={latestPost.url} class="bluesky-post__source-link" aria-label="Open on Bluesky"><span aria-hidden="true">εїз</span> <time datetime={latestPost.dateTime}>{latestPost.publishedDate}, {latestPost.publishedTime}</time></SmartLink>
        </p>
        <div class="bluesky-post__line">
          {
            latestPost.media && (
              <div class="bluesky-image">
                <button
                  type="button"
                  class="bluesky-image__trigger"
                  aria-label="Toggle larger media preview"
                  aria-expanded="false"
                >
                  <img
                    class="bluesky-image__thumb"
                    src={latestPost.media.thumb}
                    alt={latestPost.media.alt}
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                  {latestPost.media.kind === "video" ? (
                    <video
                      class="bluesky-image__large"
                      data-src={latestPost.media.src}
                      poster={latestPost.media.thumb}
                      width={latestPost.media.width}
                      height={latestPost.media.height}
                      preload="none"
                      playsinline
                      muted
                      loop
                    />
                  ) : (
                    <img
                      class="bluesky-image__large"
                      data-src={latestPost.media.src}
                      alt=""
                      loading="lazy"
                    />
                  )}
                </button>
              </div>
            )
          }
          <p>{latestPost.text}</p>
        </div>
      </article>
    </section>
  )
}

<style>
  .bluesky-post {
    margin-top: 0.75rem;
    container-type: inline-size;
  }

  .bluesky-post__line {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .bluesky-post__line > p {
    flex: 1 1 auto;
    min-width: 0;
  }

  .bluesky-post__source-link,
  .bluesky-post__source-link:hover,
  .bluesky-post__source-link:active,
  .bluesky-post__source-link:focus-visible {
    color: inherit !important;
    font-style: normal !important;
    text-decoration: none !important;
  }

  .bluesky-image {
    position: relative;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
  }

  .bluesky-image__trigger {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    padding: 0;
    cursor: zoom-in;
    background: none;
    border: 0;
    touch-action: manipulation;
    -webkit-touch-callout: none;
  }

  .bluesky-image.is-open .bluesky-image__trigger {
    cursor: zoom-out;
  }

  .bluesky-image__thumb {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0.25rem;
    object-fit: cover;
    box-shadow: 0 2px 5px 0 color-mix(in srgb, var(--color-base-950) 15%, transparent);
  }

  .bluesky-image__large {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    display: none;
    /* Never upscale: natural size, capped at the content column via the .bluesky-post inline-size container. */
    width: auto;
    max-width: 100cqw;
    height: auto;
    max-height: min(28rem, calc(100vh - 2rem));
    margin: 0;
    border-radius: 0.25rem;
    box-shadow: 0 2px 5px 0 color-mix(in srgb, var(--color-base-950) 15%, transparent);
  }

  .bluesky-image.is-open .bluesky-image__thumb {
    visibility: hidden;
  }

  .bluesky-image.is-open .bluesky-image__large {
    display: block;
  }

  video.bluesky-image__large {
    background: var(--color-base-950);
  }
</style>

<script>
  const attachVideo = async (video: HTMLVideoElement, src: string) => {
    if (video.dataset.attached) return;

    video.dataset.attached = "true";

    // Bluesky only serves HLS, which needs hls.js everywhere except browsers with native support (iOS Safari).
    const { default: Hls } = await import("hls.js/dist/hls.light.mjs");

    if (Hls.isSupported()) {
      const hls = new Hls();
      hls.loadSource(src);
      hls.attachMedia(video);
      return;
    }

    if (video.canPlayType("application/vnd.apple.mpegurl")) video.src = src;
  };

  const loadMedia = async (large: Element) => {
    const src = large instanceof HTMLElement ? large.dataset.src : undefined;

    if (!src) return;

    if (large instanceof HTMLVideoElement) {
      await attachVideo(large, src);
      large.play().catch(() => {});
      return;
    }

    if (large instanceof HTMLImageElement && !large.src) large.src = src;
  };

  const closeImage = (image: HTMLElement) => {
    image.classList.remove("is-open");
    image.querySelector<HTMLVideoElement>("video.bluesky-image__large")?.pause();
    image.querySelector(".bluesky-image__trigger")?.setAttribute("aria-expanded", "false");
  };

  document.querySelectorAll<HTMLElement>(".bluesky-image").forEach((image) => {
    const trigger = image.querySelector<HTMLElement>(".bluesky-image__trigger");
    const large = image.querySelector(".bluesky-image__large");

    trigger?.addEventListener("click", () => {
      const isOpen = image.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(isOpen));

      if (isOpen && large) {
        loadMedia(large);
      } else if (large instanceof HTMLVideoElement) {
        large.pause();
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      document.querySelectorAll<HTMLElement>(".bluesky-image.is-open").forEach(closeImage);
    }
  });
</script>
