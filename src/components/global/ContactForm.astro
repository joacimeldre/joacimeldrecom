---
import { CONTACT_RECIPIENT, CONTACT_SUBJECT } from "@/utils/contact";

interface Props {
  recipient?: string;
  class?: string;
}

const {
  recipient = CONTACT_RECIPIENT,
  class: className = "",
} = Astro.props;
---

<form data-contact-form data-recipient={recipient} data-subject={CONTACT_SUBJECT} class:list={["mt-4 space-y-4", className]} novalidate>
  <div>
    <label data-contact-label="body" class="block typo-main mb-1">What do you want to say?</label>
    <textarea
      data-contact-input="body"
      name="body"
      required
      rows="6"
      placeholder="Message"
      class="typo-main w-full rounded-md border border-base-900/25 bg-orange-50 px-3 py-2 transition-colors duration-200 placeholder:text-base-900/45 focus:border-base-900 focus:ring-0"
    ></textarea>
  </div>

  <p
    data-contact-validation
    class="hidden typo-nav text-base-900/75"
    role="status"
    aria-live="polite"
  >
    Please write a message before opening your email app.
  </p>

  <button
    data-contact-submit
    type="submit"
    class="button-link button-secondary typo-nav transition duration-200 cursor-pointer"
  >
    <span aria-hidden="true">@</span> Open in your email app
  </button>
</form>

<script>
  const forms = document.querySelectorAll("[data-contact-form]");

  forms.forEach((formElement) => {
    if (!(formElement instanceof HTMLFormElement)) {
      return;
    }

    if (formElement.dataset.contactFormReady === "true") {
      return;
    }

    const bodyInput = formElement.querySelector('[data-contact-input="body"]');
    const submitButton = formElement.querySelector("[data-contact-submit]");
    const bodyLabel = formElement.querySelector('[data-contact-label="body"]');
    const validationMessage = formElement.querySelector(
      "[data-contact-validation]",
    );
    const recipient = formElement.dataset.recipient ?? "hei@joacimeldre.com";
    const subject = formElement.dataset.subject ?? "hello through joacimeldre.com";

    if (!(bodyInput instanceof HTMLTextAreaElement)) {
      return;
    }

    if (!(submitButton instanceof HTMLButtonElement)) {
      return;
    }

    if (!(validationMessage instanceof HTMLElement)) {
      return;
    }

    // Generate unique ids at runtime so label/input links stay valid for each instance.
    const uid = Math.random().toString(36).slice(2, 10);
    bodyInput.id = `contact-body-${uid}`;

    if (bodyLabel instanceof HTMLLabelElement) {
      bodyLabel.htmlFor = bodyInput.id;
    }

    const buildMailtoHref = () => {
      const body = bodyInput.value.trim();

      return `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const setValidationState = (isValid: boolean) => {
      validationMessage.classList.toggle("hidden", isValid);
      bodyInput.setAttribute("aria-invalid", String(!isValid));
    };

    bodyInput.addEventListener("input", () => {
      setValidationState(bodyInput.value.trim().length > 0);
    });

    setValidationState(true);

    formElement.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!bodyInput.value.trim()) {
        setValidationState(false);
        bodyInput.focus();
        return;
      }

      setValidationState(true);

      window.location.href = buildMailtoHref();
    });

    formElement.dataset.contactFormReady = "true";
  });
</script>