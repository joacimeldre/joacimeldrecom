---
import { CONTACT_RECIPIENT, CONTACT_SUBJECT } from "@/utils/contact";

interface Props {
  recipient?: string;
  class?: string;
}

const {
  recipient = CONTACT_RECIPIENT,
  class: className = "",
} = Astro.props;
---

<form data-contact-form data-recipient={recipient} data-subject={CONTACT_SUBJECT} class:list={["mt-8", className]} novalidate>
  <div
    data-contact-shell
    class="contact-shell relative w-full overflow-visible bg-white shadow-[0_18px_50px_rgba(12,10,42,0.08),0_0_0_1px_rgba(12,10,42,0.06)] transition-[border-radius,box-shadow,transform] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
  >
    <button
      data-contact-toggle
      type="button"
      aria-expanded="false"
      class="relative flex w-full items-center justify-between gap-4 px-6 py-6 text-left cursor-pointer sm:px-8 sm:py-7"
    >
      <span class="typo-display-lg leading-none text-base-950 sm:typo-display-xl">Hello?</span>
      <span data-contact-toggle-icon class="contact-toggle-icon" aria-hidden="true">
        <svg
          class="contact-ghost"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 19.5V9.75C6 6.57 8.69 4 12 4s6 2.57 6 5.75v9.75c-.9 0-1.48-.68-2.1-1.38-.52-.58-1-.58-1.52 0-.67.75-1.34 1.38-2.38 1.38s-1.71-.63-2.38-1.38c-.52-.58-1-.58-1.52 0-.62.7-1.2 1.38-2.1 1.38Z"></path>
          <path d="M10 10.5h.01"></path>
          <path d="M14 10.5h.01"></path>
        </svg>
      </span>
    </button>

    <div
      data-contact-panel
      class="contact-panel"
      aria-hidden="true"
    >
      <div class="contact-panel-inner space-y-5 px-6 pb-5 pt-1 sm:px-8 sm:pb-6 sm:pt-2">
        <div class="contact-field-wrap">
          <label data-contact-label="body" class="sr-only">Hello?</label>
          <textarea
            data-contact-input="body"
            name="body"
            rows="3"
            placeholder="Message"
            class="contact-textarea typo-main block w-full resize-none rounded-lg border-2 border-base-900 bg-white px-4 py-3 text-base-950 shadow-[0_1px_0_rgba(12,10,42,0.03)] transition-[border-color,box-shadow,transform,height] duration-200 placeholder:text-base-900/45"
          ></textarea>
        </div>

        <button
          data-contact-submit
          type="submit"
          class="button-link button-secondary typo-nav cursor-pointer transition duration-200"
        >
          <span aria-hidden="true">@</span> Open in your email app
        </button>
      </div>
    </div>
  </div>
</form>

<style>
  .contact-shell {
    isolation: isolate;
    border-radius: 1rem;
  }

  .contact-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 1)),
      radial-gradient(circle at top, rgba(255, 204, 0, 0.08), transparent 42%);
    pointer-events: none;
  }

  .contact-shell > * {
    position: relative;
    z-index: 1;
  }

  .contact-panel {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease,
      margin-top 500ms cubic-bezier(0.22, 1, 0.36, 1);
    margin-top: 0;
    pointer-events: none;
  }

  .contact-field-wrap {
    line-height: 0;
  }

  .contact-toggle-icon {
    position: relative;
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease;
    color: rgba(12, 10, 42, 0.72);
  }

  .contact-ghost {
    width: 1.5rem;
    height: 1.5rem;
    animation: ghost-sidle 3.6s ease-in-out infinite;
    animation-play-state: running;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease;
  }

  @keyframes ghost-sidle {
    0%,
    100% {
      transform: translateX(0);
    }

    50% {
      transform: translateX(-1rem);
    }
  }

  .contact-textarea {
    appearance: none;
    -webkit-appearance: none;
    min-height: 2rem;
    overflow-y: hidden;
  }

  .contact-textarea:focus:not(:focus-visible) {
    outline: none;
    border-color: #000;
    box-shadow: inset 0 0 0 1px #000;
  }

  .contact-textarea:focus-visible {
    border-color: #000;
    box-shadow: inset 0 0 0 1px #000;
  }

  .contact-shell[data-open="true"] .contact-panel {
    max-height: 32rem;
    opacity: 1;
    margin-top: -0.5rem;
    pointer-events: auto;
  }

  .contact-shell[data-open="true"] .contact-toggle-icon {
    transform: translateX(0);
  }

  .contact-shell[data-open="true"] .contact-ghost {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-shell,
    .contact-panel,
    .contact-toggle-icon {
      transition: none;
    }
  }
</style>

<script>
  const forms = document.querySelectorAll("[data-contact-form]");

  forms.forEach((formElement) => {
    if (!(formElement instanceof HTMLFormElement)) {
      return;
    }

    if (formElement.dataset.contactFormReady === "true") {
      return;
    }

    const bodyInput = formElement.querySelector('[data-contact-input="body"]');
    const submitButton = formElement.querySelector("[data-contact-submit]");
    const bodyLabel = formElement.querySelector('[data-contact-label="body"]');
    const toggleButton = formElement.querySelector("[data-contact-toggle]");
    const shellElement = formElement.querySelector("[data-contact-shell]");
    const panelElement = formElement.querySelector("[data-contact-panel]");
    const recipient = formElement.dataset.recipient ?? "hei@joacimeldre.com";
    const subject = formElement.dataset.subject ?? "hello through joacimeldre.com";

    if (!(bodyInput instanceof HTMLTextAreaElement)) {
      return;
    }

    if (!(submitButton instanceof HTMLButtonElement)) {
      return;
    }

    if (!(toggleButton instanceof HTMLButtonElement)) {
      return;
    }

    if (!(shellElement instanceof HTMLElement)) {
      return;
    }

    if (!(panelElement instanceof HTMLElement)) {
      return;
    }

    // Generate unique ids at runtime so label/input links stay valid for each instance.
    const uid = Math.random().toString(36).slice(2, 10);
    bodyInput.id = `contact-body-${uid}`;
    panelElement.id = `contact-panel-${uid}`;

    if (bodyLabel instanceof HTMLLabelElement) {
      bodyLabel.htmlFor = bodyInput.id;
    }

    toggleButton.setAttribute("aria-controls", panelElement.id);

    const setAccordionState = (isOpen: boolean) => {
      shellElement.dataset.open = String(isOpen);
      toggleButton.setAttribute("aria-expanded", String(isOpen));
      panelElement.setAttribute("aria-hidden", String(!isOpen));
      panelElement.toggleAttribute("inert", !isOpen);
      bodyInput.tabIndex = isOpen ? 0 : -1;
      submitButton.tabIndex = isOpen ? 0 : -1;
    };

    const buildMailtoHref = () => {
      const body = bodyInput.value.trim();

      return `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const autoResizeBodyInput = () => {
      bodyInput.style.height = "auto";
      bodyInput.style.height = `${Math.max(bodyInput.scrollHeight, 32)}px`;
    };

    bodyInput.addEventListener("input", () => {
      autoResizeBodyInput();
    });

    toggleButton.addEventListener("click", () => {
      const isOpen = toggleButton.getAttribute("aria-expanded") === "true";
      setAccordionState(!isOpen);
    });

    setAccordionState(false);
    autoResizeBodyInput();

    formElement.addEventListener("submit", (event) => {
      event.preventDefault();

      window.location.href = buildMailtoHref();
    });

    formElement.dataset.contactFormReady = "true";
  });
</script>