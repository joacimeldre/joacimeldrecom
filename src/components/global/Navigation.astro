---
import Logo from "@/components/global/Logo.astro";

const navItems = [
  { href: "/about", label: "About" },
  { href: "/contact", label: "Hello" },
];

const isActive = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname === `${href}/`;
---

<div
  class="mt-5 relative flex flex-row w-full mx-auto items-center justify-between"
>
  <div>
    <a href="/" aria-label="Home" class="logo-link">
      <Logo
        width={32}
        height={32}
        class="h-8 w-8 max-w-none block"
      />
    </a>
  </div>
  <nav class="flex ml-auto items-center gap-5 sm:gap-6">
    {
      navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class:list={["typo-nav nav-link transition duration-200", { "font-bold": active }]}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</div>
