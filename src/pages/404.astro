---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import tomAndJerry from "../content/images/page/404/tomAndJerryAnimation.webp";

export const prerender = true;
---

<BaseLayout
    title="404 - Page not found"
    description="Oh, no! The page you're looking for doesn't exist."
>
<section>
    <div class="pt-16">
        <h1
            class="typo-display-xl mb-2"
        >
            404
        </h1>
        <p class="typo-main mb-8">
            Oh, no! The page you're looking for doesn't exist.
        </p>
        <p class="typo-main mb-8">
            <a href="/">Return to base!</a>
        </p>
        <Image
            src={tomAndJerry}
            alt="An animation of Tom the cat laying on a yellow couch, using Jerry the mouse as a ball with a ping pong racket"
            title="Tom and Jerry - 404"
            class="mt-12 max-w-3/4 rounded-lg mx-auto"
        />
    </div>
</section>
</BaseLayout>
