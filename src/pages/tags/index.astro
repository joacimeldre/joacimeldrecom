---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { tagToSlug } from "@/utils/tagSlug";

export const prerender = true;

const allPosts = await getCollection("posts");
const visiblePosts = import.meta.env.DEV
  ? allPosts
  : allPosts.filter((post) => post.data.published);
const tags = [...new Set(visiblePosts.map((post) => post.data.tags).flat())];
const sortedTags = tags.sort((a, b) => a.localeCompare(b)); // Sort tags alphabetically

const pageTitle = "posts - Joacim Eldre";
---

<BaseLayout title={pageTitle}>
  <section>
    <div class="pt-16">
      <h1
        class="typo-display-xl max-w-xl"
      >
        All tags
      </h1>
      <div class="flex flex-wrap gap-3 mt-8">
        {
          sortedTags.map((tag) => (
            <a
              class="typo-main"
              href={`/tags/${encodeURIComponent(tagToSlug(tag))}`}
            >
              {tag}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
