---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogEntries from "@/components/entries/BlogEntry.astro";
import { getCollection, type CollectionEntry } from "astro:content";
export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const visiblePosts = import.meta.env.DEV
    ? allPosts
    : allPosts.filter((post) => post.data.published);
  const uniqueTags = [
    ...new Set(visiblePosts.map((post) => post.data.tags).flat()),
  ];

  return uniqueTags.map((tag) => {
    // Filter posts by tag
    const filteredPosts = visiblePosts.filter((post) =>
      post.data.tags.includes(tag),
    );
    // Sort filtered posts by date in descending order
    const sortedPosts = filteredPosts.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
    );

    return {
      params: { tag },
      props: { posts: sortedPosts },
    };
  });
}

const allPosts = await getCollection("posts");
const visiblePosts = import.meta.env.DEV
  ? allPosts
  : allPosts.filter((post) => post.data.published);

// Sort tags by name in alphabetical order, ignoring case sensitivity
const tags = [...new Set(visiblePosts.map((post) => post.data.tags).flat())].sort(
  (a, b) => a.toLowerCase().localeCompare(b.toLowerCase()),
);

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: CollectionEntry<"posts">[] };
---

<BaseLayout title={`${tag} posts - Joacim Eldre`}>
  <section>
    <div class="pt-16">
      <h1
        class="typo-display-xl mb-2"
      >
        Show posts tagged with
      </h1>
      <div class="flex flex-wrap gap-3 mt-2">
        {
          tags.map((t) => {
            const isActive = t === tag;
            const classes = isActive
              ? "font-bold typo-main tag-link"
              : "typo-main tag-link";

            return (
              <a class={classes} href={`/tags/${encodeURIComponent(t)}`}>
                {t}
              </a>
            );
          })
        }
      </div>
      <h2
        class="typo-display-xl max-w-xl mt-8"
      >
        ö {tag}
      </h2>
      <ul class="mt-4">
        {
          posts.map((post) => (
            <BlogEntries
              url={"/posts/" + post.id.replace(/\.(md|mdx)$/i, "")}
              title={post.data.title}
              pubDate={post.data.pubDate.toISOString().split("T")[0]}
              draft={!post.data.published}
            />
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
