---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
    title="Contact - Joacim Eldre"
    description="Say hello. Or don't. It's up to you. If you do, I'll say hello back. Perhaps we can have a longer chat, too!"
>
    <section>
        <div class="pt-16 max-w-xl2">
            <h1 class="typo-display-xl mb-4">Hi there!</h1>
            <p class="typo-main mt-4">
                Send me a message if you want a logo (price depends), an icon or fifty (from 500 NOK per icon), or to say hi and have a chat.            </p>
            <p class="typo-main mt-4">
                <a href="mailto:hei@joacimeldre.com">hei@joacimeldre.com</a>.
            </p>
        </div>
    </section>
</BaseLayout>
