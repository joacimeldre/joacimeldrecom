---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/global/ContactForm.astro";

export const prerender = true;
---

<BaseLayout
    title="Contact - Joacim Eldre"
    description="Say hello. Or don't. It's up to you. If you do, I'll say hello back. Perhaps we can have a longer chat, too!"
>
    <section>
        <div class="pt-16 max-w-xl2">
            <h1 class="typo-display-xl mb-4">Hello! Hei! And so on.</h1>
            <p class="typo-main mt-4">
                You can contact me on <a href="mailto:hei@joacimeldre.com">hei@joacimeldre.com</a>.
            </p>
            <p class="typo-main mt-4">
                If you want me to make you a logo (for money), some icons (for money), or just to chat chit (for free). Or chit chat (also for free).
            </p>
            <p class="typo-main mt-4">
                I think that's it for this page. Yep! Have fun.
            </p>
        </div>
    </section>
</BaseLayout>
