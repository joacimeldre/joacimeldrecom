---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
    title="Contact - Joacim Eldre"
    description="Say hello. Or don't. It's up to you. If you do, I'll say hello back. Perhaps we can have a longer chat, too!"
>
    <section>
        <div class="pt-16 max-w-xl2">
            <h1 class="typo-display-xl mb-4">Hello! And so on.</h1>
            <p class="typo-main mt-4">
                <a href="mailto:hei@joacimeldre.com">hei@joacimeldre.com</a>. That's it.
            </p>
            <p class="typo-main mt-4">
                Send me a message if you want a logo (for money), some icons (for money), or just to chat chit (for free). Or chit chat (also for free).
            </p>
        </div>
    </section>
</BaseLayout>
