---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogEntries from "@/components/entries/BlogEntry.astro";
import LatestBlueskyPost from "@/components/global/LatestBlueskyPost.astro";
import { getCollection } from "astro:content";

// Short CDN TTL so the Bluesky post stays reasonably fresh without rendering per request.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=86400",
);

const allPosts = await getCollection("posts");
const visiblePosts = import.meta.env.DEV
  ? allPosts
  : allPosts.filter((post) => post.data.published);
// Sort posts by date in descending order (newest first)
const sortedPosts = visiblePosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<BaseLayout
  title="Designer & adventure.. er - Joacim Eldre"
  description="Things made by and adventures gone to with Joacim Eldre. A designer, adventurer, and lover of all things yellow. Joacim is based in south-east Norway."
>
  <section>
    <div class="pt-16">
    <h1 class="typo-display-xl">
        Hei! <a href="/about/" class="decoration-1 underline-offset-4">I'm Joacim</a>.
    </h1>
    <p class="mt-8 typo-display-xl text-balance">
        I place pixels and write words. Once in a while I draw icons and logos for people. And make tiny video games.
    </p>
    <h2 class="mt-8 typo-display-lg">
        These days I'm
    </h2>
    <ul class="list-disc list-outside mt-3 pl-6 typo-main space-y-2">
        <li>making a <i>logo</i> for a local lumberjack. There be trees! /\</li>
        <li>reading <i>Annihilation</i>, <i>Psych</i>, & <i>Slow Productivity</i>.</li>
        <li>making <i>oio</i>, a tiny video game.</li>
        <li>playing <i>It Takes Two</i>.</li>
    </ul>
    <h2 class="mt-8 typo-display-lg">
        Recent writings
    </h2>
    <ul class="mt-2">
        {
          sortedPosts
            .slice(0, 5)
            .map((post) => (
              <BlogEntries
                url={"/posts/" + post.id.replace(/\.(md|mdx)$/i, "")}
                title={post.data.title}
                pubDate={post.data.pubDate.toISOString().split("T")[0]}
                draft={!post.data.published}
              />
            ))
        }
      </ul>
      <p class="mt-2 typo-main">
        Or see <a href="/tags/all">all posts</a>.
      </p>
    <LatestBlueskyPost server:defer>
        <div slot="fallback" class="relative mt-10 pt-16" aria-hidden="true">
            <div class="absolute top-0 left-7 h-25 w-21 animate-pulse motion-reduce:animate-none rounded-t-full bg-base-900/10"></div>
            <div class="relative rounded-2xl bg-white p-7">
                <div class="h-4 w-48 animate-pulse motion-reduce:animate-none rounded bg-base-900/10"></div>
                <div class="mt-3 space-y-2">
                    <div class="h-5 w-full animate-pulse motion-reduce:animate-none rounded bg-base-900/10"></div>
                    <div class="h-5 w-2/3 animate-pulse motion-reduce:animate-none rounded bg-base-900/10"></div>
                </div>
            </div>
        </div>
    </LatestBlueskyPost>
    </div>
  </section>
</BaseLayout>
