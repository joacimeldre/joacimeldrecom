---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogEntries from "@/components/entries/BlogEntry.astro";
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
const visiblePosts = import.meta.env.DEV
  ? allPosts
  : allPosts.filter((post) => post.data.published);
// Sort posts by date in descending order (newest first)
const sortedPosts = visiblePosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<BaseLayout
  title="Designer, Coder, Adventure.. er - Joacim Eldre"
  description="Explore the designs, games, writings, projects, and adventures of Joacim Eldre. A designer, adventurer, and lover of all things yellow. Joacim is based in south-east Norway."
>
  <section>
    <div class="pt-16">
      <h1 class="typo-display-xl">
        Hei! <a href="/about/" class="decoration-1 underline-offset-4">I'm Joacim.</a>
      </h1>
      <h1 class="mt-8 typo-display-xl">
        I design software in public healthcare, once in a while I draw icons, logos, and apps for people. And make tiny video games.
      </h1>
      <h2 class="mt-8 typo-display-lg">
        These days I'm
      </h2>
      <ul class="list-disc list-outside mt-3 pl-6 typo-main space-y-2">
        <li>playing <i>Rime</i> and <i>Naiad</i>.</li>
        <li>drawing a small knitting guide.</li>
        <li>designing a <i>logo</i> for a local lumberjack. There be trees.</li>
        <li>reading <i>Dungeon Crawler Carl</i>. Go Donut! 🐈</li>
        <li>noodling with ideas of worms and bombs for tiny video games. 🐛💣</li>
      </ul>
      <h2 class="mt-8 typo-display-lg">
        Recent writings
      </h2>
      <ul class="mt-4">
        {
          sortedPosts
            .slice(0, 5)
            .map((post) => (
              <BlogEntries
                url={"/posts/" + post.id.replace(/\.(md|mdx)$/i, "")}
                title={post.data.title}
                pubDate={post.data.pubDate.toISOString().split("T")[0]}
                draft={!post.data.published}
              />
            ))
        }
      </ul>
      <p class="mt-4 typo-main">
        Or find <a href="/tags/All/">all posts</a>.
      </p>
    </div>
  </section>
</BaseLayout>
