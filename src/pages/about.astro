---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Adventure from "../content/images/page/about/Adventure.webp";
---

<BaseLayout
    title="About - Joacim Eldre"
    description="Learn more about Joacim Eldre, a designer, coder, adventurer, and lover of all things yellow."
>
    <section>
        <div class="pt-16 max-w-xl2">
            <h1 class="typo-display-xl mb-4">
                I'm a boy, friend, dad, adventurer, nerd, rainbow spewer, human.
            </h1>
            <p class="mt-6 typo-main">
                I like doing. Designing. Drawing. Coding. Discovering. Writing.
                Sharing. Helping. Learning. Adventuring. Laughing. Living.
                Loving.
            </p>
            <p class="mt-6 typo-main">
                I'm formally educated as a visual designer and game designer, and I have a strong interest in and some work experience with code. Mostly no/low code, but I prefer to write and enjoy code that's not abstracted away. I'm currently exploring how to become more proficient in code, and I bring a design mindset into that journey, reiterating fast to get somewhere, testing, and improving.
            </p>
            <p class="mt-6 typo-main">
                I design software in public healthcare. We're currently working
                on remote patient care, and hospital porter transport.
            </p>
            <p class="mt-6 typo-main">
                In my spare time I spend as much time as I can with family and
                friends, draw, design, play video games, make video games, use my hands on crafty things like knitting and woodworking, and go on adventures.
            </p>
            <Image
                src={Adventure}
                alt="A photo of my son and me on a hiking adventure in a forest, I've drawn a bunch doodles around us."
                title="My son and me on an adventure"
                class="mt-12 rounded-lg mx-auto"
            />
            <h2
                class="mt-8 typo-display-lg mb-4"
            >
                I really like
            </h2>
            <ul
                class="list-disc list-inside mt-6 typo-main space-y-2"
            >
                <li>design systems.</li>
                <li>visual design.</li>
                <!-- prettier-ignore -->
                <li><span class="inline-highlight bg-amber-200 p-1 rounded-xs" style="--selection-highlight: #fde68a;">yellow.</span></li>
                <li>patterns.</li>
                <li>listening to rain.</li>
                <li>drawing.</li>
                <li>video games.</li>
            </ul>
            <h2
                class="mt-8 typo-display-lg mb-4"
            >
                Play
            </h2>
            <p class="mt-6 typo-main">
                I make tiny video games (see <a href="/posts/2026-06-12-bloob-final/">Bloob</a> and <a href="/posts/2026-07-22-shapedrifter/">Shapedrifter</a>) for my kids and me.
            </p>
            <p class="mt-6 typo-main">
                We also like to play outside, doing fun little things like pretending that the ground is lava! And we have to step on small rocks and grass patches or balance along trees to not fall into the lava.
            </p>
            <h2 class="mt-10 typo-display-lg mb-4">
                Contact
            </h2>
            <form id="contact-form" class="mt-4 space-y-4" novalidate>
                <div>
                    <label for="contact-subject" class="block typo-nav mb-1 text-base-900">What?</label>
                    <input
                        id="contact-subject"
                        name="subject"
                        type="text"
                        required
                        placeholder="Subject"
                        class="typo-nav w-full rounded-md border border-base-900/25 bg-orange-50 px-3 py-2 transition-colors duration-200 placeholder:text-base-900/45 focus:border-base-900 focus:ring-0"
                    />
                </div>

                <div>
                    <label for="contact-body" class="block typo-nav mb-1 text-base-900">Why? When? Who? Where?</label>
                    <textarea
                        id="contact-body"
                        name="body"
                        required
                        rows="6"
                        placeholder="Body"
                        class="typo-nav w-full rounded-md border border-base-900/25 bg-orange-50 px-3 py-2 transition-colors duration-200 placeholder:text-base-900/45 focus:border-base-900 focus:ring-0"
                    ></textarea>
                </div>

                <button
                    id="contact-submit"
                    type="submit"
                    class="button-link bg-accent text-base-900 typo-nav py-2 px-3 sm:px-4 rounded-full transition duration-200 hover:bg-base-900 hover:text-base-50 cursor-pointer"
                >
                    <span aria-hidden="true">@</span> Open in your email app
                </button>
            </form>
        </div>
    </section>

    <script is:inline>
        const contactForm = document.getElementById("contact-form");
        const submitButton = document.getElementById("contact-submit");
        const subjectInput = document.getElementById("contact-subject");
        const bodyInput = document.getElementById("contact-body");

        const buildMailtoHref = () => {
            const subject =
                subjectInput instanceof HTMLInputElement
                    ? subjectInput.value.trim()
                    : "";
            const body =
                bodyInput instanceof HTMLTextAreaElement
                    ? bodyInput.value.trim()
                    : "";

            return `mailto:hei@joacimeldre.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        };

        const updateMailtoPreview = () => {
            if (submitButton instanceof HTMLButtonElement) {
                submitButton.title = buildMailtoHref();
            }
        };

        if (subjectInput instanceof HTMLInputElement) {
            subjectInput.addEventListener("input", updateMailtoPreview);
        }

        if (bodyInput instanceof HTMLTextAreaElement) {
            bodyInput.addEventListener("input", updateMailtoPreview);
        }

        if (submitButton instanceof HTMLButtonElement) {
            submitButton.addEventListener("mouseenter", updateMailtoPreview);
            submitButton.addEventListener("focus", updateMailtoPreview);
        }

        updateMailtoPreview();

        if (contactForm instanceof HTMLFormElement) {
            contactForm.addEventListener("submit", (event) => {
                event.preventDefault();

                if (
                    !(subjectInput instanceof HTMLInputElement) ||
                    !(bodyInput instanceof HTMLTextAreaElement)
                ) {
                    return;
                }

                if (!subjectInput.value.trim() || !bodyInput.value.trim()) {
                    contactForm.reportValidity();
                    return;
                }

                const mailtoHref = buildMailtoHref();

                window.location.href = mailtoHref;
            });
        }
    </script>
</BaseLayout>
