---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "../../layouts/BlogLayout.astro";
import { estimateReadingStats } from "@/utils/readingTime";
export const prerender = true;

export async function getStaticPaths() {
  const blogEntries = await getCollection("posts");
  const visibleEntries = import.meta.env.DEV
    ? blogEntries
    : blogEntries.filter((entry) => entry.data.published);

  return visibleEntries.map((entry) => ({
    params: {
      slug: entry.id.replace(/\.(md|mdx)$/i, ""),
    },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const readingStats = estimateReadingStats(entry.body);
---

<MarkdownPostLayout frontmatter={entry.data} readingStats={readingStats}>
  <Content />
</MarkdownPostLayout>
